{
    "name": "alareqi/filament-ai-assistant",
    "description": "A panel assistant that prepares reviewable changes through existing Filament resource forms.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "filament", "ai", "assistant"],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "laravel/ai": "^1.4"
    },
    "require-dev": {
        "laravel/pint": "^1.26",
        "orchestra/testbench": "^10.6|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Alareqi\\FilamentAiAssistant\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alareqi\\FilamentAiAssistant\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["Alareqi\\FilamentAiAssistant\\FilamentAiAssistantServiceProvider"]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
